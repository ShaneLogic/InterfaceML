    &END COORD
    &KIND H
      ELEMENT H
      BASIS_SET DZVP-MOLOPT-SR-GTH-q1
      POTENTIAL GTH-PBE
    &END KIND
    &KIND Pb
      ELEMENT Pb
      BASIS_SET DZVP-MOLOPT-SR-GTH-q4
      POTENTIAL GTH-PBE
    &END KIND
    &KIND C
      ELEMENT C
      BASIS_SET DZVP-MOLOPT-SR-GTH-q4
      POTENTIAL GTH-PBE
    &END KIND
    &KIND I
      ELEMENT I
      BASIS_SET DZVP-MOLOPT-SR-GTH-q7
      POTENTIAL GTH-PBE
    &END KIND
    &KIND N
      ELEMENT N
      BASIS_SET DZVP-MOLOPT-SR-GTH-q5
      POTENTIAL GTH-PBE
    &END KIND
    &KIND Ti
      ELEMENT Ti
      BASIS_SET DZVP-MOLOPT-SR-GTH-q12
      POTENTIAL GTH-PBE
    &END KIND
    &KIND O
      ELEMENT O
      BASIS_SET DZVP-MOLOPT-SR-GTH-q6
      POTENTIAL GTH-PBE
    &END KIND
  &END SUBSYS

 &DFT
    BASIS_SET_FILE_NAME  BASIS_MOLOPT
    BASIS_SET_FILE_NAME  BASIS_MOLOPT_LnPP2
    POTENTIAL_FILE_NAME  /work/home/acumzqsmb7/CP2K-template/POTENTIAL_LnPP2
#   WFN_RESTART_FILE_NAME li6ps5cl_ceo2_lnpp2_ot-RESTART.wfn
    CHARGE    0 #Net charge
    MULTIPLICITY 1 #Spin multiplicity
    UKS
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12 #Set all EPS_xxx to values such that the energy will be correct up to this value
    &END QS
    &POISSON
      PERIODIC XYZ #Direction(s) of PBC for calculating electrostatics
      PSOLVER PERIODIC #The way to solve Poisson equation
    &END POISSON
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &MGRID
      CUTOFF  400
      REL_CUTOFF  55
    &END MGRID
    &SCF
      MAX_SCF 128 #Maximum number of steps of inner SCF
      EPS_SCF 1.0E-07 #Convergence threshold of density matrix of inner SCF
#     SCF_GUESS RESTART #Use wavefunction from WFN_RESTART_FILE_NAME file as initial guess
#     IGNORE_CONVERGENCE_FAILURE #Continue calculation even if SCF not converged, works for version >= 2024.1
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING 
        ALPHA 0.4
        NBROYDEN 8
      &END MIXING
      &PRINT
        &RESTART #Note: Use "&RESTART OFF" can prevent generating .wfn file
          BACKUP_COPIES 0 #Maximum number of backup copies of wfn file. 0 means never
        &END RESTART
      &END PRINT
    &END SCF
  &END DFT
 
 &PRINT
    &STRESS_TENSOR ON #Print stress tensor
    &END STRESS_TENSOR

    &FORCES ON
    &END FORCES
    
    &E_DENSITY_CUBE ON
      STRIDE 1 1 1
    &END E_DENSITY_CUBE

    &WFN_RESTART_FILE
        FILENAME mapbi3_tio2_scf.wfn
        ADD_LAST NUMERIC
    &END WFN_RESTART_FILE
  &END PRINT
  
  STRESS_TENSOR ANALYTICAL #Compute full stress tensor analytically

&END FORCE_EVAL

